generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlanetType {
  TERRESTRIAL
  GAS_GIANT
  ICE_GIANT
  DWARF_PLANET
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Planet {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique
  type            PlanetType
  mass            Float
  radius          Float
  distanceFromSun Float
  satellites      Satellite[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("planets")
}

model Satellite {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  mass      Float
  radius    Float
  planetId  String   @db.Uuid
  planet    Planet   @relation(fields: [planetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("satellites")
}
